{
    "name": "netresearch/nr-landingpage",
    "type": "typo3-cms-extension",
    "description": "TYPO3 Landing Page Generator powered by LLM",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.2",
        "netresearch/nr-llm": "^0.4.0",
        "typo3/cms-core": "^13.4 || ^14.0",
        "typo3/cms-backend": "^13.4 || ^14.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpat/phpat": "^0.11",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "rector/rector": "^2.0",
        "saschaegerer/phpstan-typo3": "^2.0 || ^3.0",
        "typo3/testing-framework": "^8.0 || ^9.0"
    },
    "suggest": {
        "typo3/cms-workspaces": "Workspace support for generated pages"
    },
    "autoload": {
        "psr-4": {
            "Netresearch\\NrLandingpage\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Netresearch\\NrLandingpage\\Tests\\": "Tests/"
        }
    },
    "scripts": {
        "ci": [
            "@ci:phpstan",
            "@ci:cgl",
            "@ci:tests"
        ],
        "ci:phpstan": ".Build/bin/phpstan analyse -c phpstan.neon --no-progress",
        "ci:cgl": ".Build/bin/php-cs-fixer fix --dry-run --diff",
        "ci:tests": ".Build/bin/phpunit -c phpunit.xml",
        "fix:cgl": ".Build/bin/php-cs-fixer fix"
    },
    "config": {
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true,
            "phpstan/extension-installer": true
        },
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "nr_landingpage",
            "web-dir": ".Build/Web"
        }
    }
}
