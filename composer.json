{
    "name": "netresearch/nr-landingpage",
    "type": "typo3-cms-extension",
    "description": "Landing Page Generator - Generate landing pages with an LLM in a step-by-step backend wizard.",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.2",
        "netresearch/nr-llm": "^0.34 || ^0.35 || ^0.36 || ^0.37 || ^0.38 || ^0.39",
        "typo3/cms-core": "^13.4 || ^14.3",
        "typo3/cms-backend": "^13.4 || ^14.3",
        "typo3/html-sanitizer": "^2.3.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpat/phpat": "^0.11 || ^0.12",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "rector/rector": "^2.0",
        "saschaegerer/phpstan-typo3": "^2.0 || ^3.0",
        "typo3/testing-framework": "^8.0 || ^9.0"
    },
    "suggest": {
        "typo3/cms-workspaces": "Workspace support for generated pages"
    },
    "autoload": {
        "psr-4": {
            "Netresearch\\NrLandingpage\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Netresearch\\NrLandingpage\\Tests\\": "Tests/"
        }
    },
    "scripts": {
        "ci": [
            "@ci:phpstan",
            "@ci:cgl",
            "@ci:tests"
        ],
        "ci:phpstan": ".Build/bin/phpstan analyse -c phpstan.neon --no-progress",
        "ci:cgl": ".Build/bin/php-cs-fixer fix --dry-run --diff",
        "ci:tests": ".Build/bin/phpunit -c phpunit.xml",
        "ci:tests:functional": ".Build/bin/phpunit -c phpunit.functional.xml",
        "fix:cgl": ".Build/bin/php-cs-fixer fix"
    },
    "config": {
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true,
            "phpstan/extension-installer": true
        },
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-6j95-1jtb-x6wc": "enshrined/svg-sanitize is transitive via typo3/cms-core, which requires ~0.22; the advisory is fixed only in 1.0.0. Remove this ignore once typo3/cms-core allows the fix.",
                    "PKSA-8j6w-3kr7-s9xk": "enshrined/svg-sanitize is transitive via typo3/cms-core, which requires ~0.22; the advisory is fixed only in 1.0.0. Remove this ignore once typo3/cms-core allows the fix.",
                    "PKSA-cbx2-m9db-bmzd": "enshrined/svg-sanitize is transitive via typo3/cms-core, which requires ~0.22; the advisory is fixed only in 1.0.0. Remove this ignore once typo3/cms-core allows the fix."
                }
            }
        },
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "nr_landingpage",
            "web-dir": ".Build/Web"
        }
    }
}
